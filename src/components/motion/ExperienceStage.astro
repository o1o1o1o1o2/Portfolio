---
import { translator, type Locale } from '../../i18n';
import KineticLink from './KineticLink.astro';
interface Props { base: string; lang?: Locale; }
const { base, lang = 'ru' } = Astro.props;
const t = translator(lang);
const previews = [
  {image:'eco.webp',name:'Eco Tycoon',className:'experience-eco'},
  {image:'thesia-heroes.webp',name:'Thesia: Isekai World RPG',className:'experience-berserk'},
  {image:'berserk-header.jpg',name:'Berserk Heroes Online',className:'experience-samedi'},
];
---
<section class="experience-stage m-wrap" aria-labelledby="experience-title" data-intro-once data-intro-panel>
  <div class="experience-meta"><span>UNITY / C# · GAME DEVELOPMENT</span><span>{t('ui48')}</span></div>
  <div class="experience-copy"><h2 id="experience-title" data-row-reveal><span data-reveal-row>{t('ui49')}</span><em data-reveal-row>{t('ui50')}</em><em data-reveal-row>{t('ui51')}</em><em data-reveal-row>{t('ui52')}</em></h2><KineticLink label={t('ui66')} href="#contact"/></div>
  <div class="experience-collage" data-slide="right" aria-label={t('ui70')}>{previews.map(item=><figure class={item.className}><img src={`${base}/images/${item.image}`} alt={item.name} loading="eager" width="526" height="296"/><figcaption>{item.name}</figcaption></figure>)}</div>
</section>
