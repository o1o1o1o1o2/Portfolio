---
import portfolio from '../../content/portfolio.json';
import '../../styles/concepts.css';
export function getStaticPaths() { return ['editorial', 'blueprint', 'atelier'].map(concept => ({ params: { concept } })); }
const concept = Astro.params.concept as 'editorial' | 'blueprint' | 'atelier';
const variants = {
  editorial: { number: '01', name: 'Editorial', subtitle: 'Светлый · редакционный · контент на первом плане', title: 'Разрабатываю игры. Думаю системами.', description: 'Чистый светлый фон, выразительная типографика и крупные игровые кадры. Сначала проекты — затем инженерная глубина.', accent: 'Кобальт / мел / графит' },
  blueprint: { number: '02', name: 'Blueprint', subtitle: 'Тёмный · инженерный · собранный', title: 'Игровой опыт. Инженерный подход.', description: 'Глубокий синий, точная сетка и технические детали. Акцент на том, как устроены проекты и какую задачу я решил.', accent: 'Полночь / ледяной синий / белый' },
  atelier: { number: '03', name: 'Atelier', subtitle: 'Тёплый · авторский · спокойный', title: 'Серьёзно к коду. С интересом к игре.', description: 'Тёплая бумага, крупная антиква и свободный ритм. Личная подача разработчика, которому нравится создавать миры.', accent: 'Бумага / терракота / чернила' },
};
const v = variants[concept];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (slug: string) => `${base}/concepts/${slug}/`;
const gameImages: Record<string,string> = { 'samedi-manor': 'samedi.webp', 'eco-tycoon': 'eco.webp', 'berserk-heroes-online': 'berserk.jpg' };
const games = [portfolio.games[1], portfolio.games[0], portfolio.games[2], portfolio.games[3]];
const backend = portfolio.backend[0];
const article = portfolio.articles[0];
---
<!doctype html><html lang="ru"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>{v.name} — концепт портфолио</title><link rel="icon" href={`${base}/favicon.svg`}/></head>
<body class={concept}>
  <div class="concept-bar"><a href={`${base}/concepts/`}>← Все концепты</a><span>КОНЦЕПТ {v.number} / {v.name}</span><nav aria-label="Выбор концепта">{Object.entries(variants).map(([slug,item])=><a href={url(slug)} aria-current={slug===concept ? 'page':undefined}>{item.number}<span> {item.name}</span></a>)}</nav></div>
  <a class="c-skip" href="#content">К содержимому</a>
  <header class="c-header c-wrap"><a class="c-logo" href="#content">{concept==='blueprint' ? <span class="logo-brackets">{'{ d }'}</span> : <span class="logo-mark">d.</span>}<span>Данил<span class="logo-caption">разработчик</span></span></a><nav aria-label="Навигация сайта"><a href="#games">Игры</a><a href="#backend">Бэкенд</a><a href="#articles">Статьи</a></nav><a class="c-contact" href="#contact">Связаться <span>↗</span></a></header>
  <main id="content">
    <section class="c-hero c-wrap">
      <div class="hero-copy"><div class="c-eyebrow">{concept==='blueprint' ? '// SOFTWARE ENGINEER' : 'UNITY / C# GAME DEVELOPER'}</div><h1>{concept==='editorial' ? <>Разрабатываю<br/>игры. <em>Думаю<br/>системами.</em></> : concept==='blueprint' ? <>Игровой опыт.<br/><em>Инженерный<br/>подход.</em></> : <>Серьёзно к коду.<br/><em>С интересом<br/>к игре.</em></>}</h1><p>Создаю игровые системы на Unity / C#.<br/>Архитектура, механики, инструменты и оптимизация.<br/>В личном проекте развиваю бэкенд на Go.</p><div class="hero-actions"><a class="c-button" href="#games">Смотреть проекты <span>↗</span></a><a class="c-secondary" href="#backend">Инженерный опыт ↓</a></div></div>
      {concept==='blueprint' ? <div class="hero-engineering"><div class="code-header"><span>01 — SYSTEM OVERVIEW</span><span>●</span></div><div class="blueprint-nodes"><div class="node-title">GAME EXPERIENCE</div><div class="node-connector">↓</div><div class="node-row"><span>GAMEPLAY</span><span>UI / TOOLS</span></div><div class="node-connector">↓</div><div class="node-core">MODULAR SYSTEMS<small>C# · Unity · ECS · DI</small></div><div class="node-connector">↓</div><div class="node-row"><span>INTEGRATIONS</span><span>OPTIMIZATION</span></div></div><div class="hero-code-footer"><span>Чёткие границы.</span><span>Понятные зависимости.</span></div><div class="blueprint-preview"><img src={`${base}/images/samedi.webp`} alt="Samedi Manor — игровой кадр"/><div>Samedi Manor<small>Игровая логика / auto-battler</small></div><span>↗</span></div></div> : <figure class="hero-figure"><div class="figure-label"><span>SELECTED WORK / 01</span><span>UNITY · MOBILE</span></div><img src={`${base}/images/samedi.webp`} alt="Официальное изображение игры Samedi Manor" width="526" height="296" fetchpriority="high"/><figcaption><div><strong>Samedi Manor</strong><span>От игровой логики до боевого режима</span></div><a href="#game-samedi-manor" aria-label="Мой вклад в Samedi Manor">↗</a></figcaption>{concept==='atelier' && <span class="hand-note">Миры, к которым<br/>я приложил руку ↗</span>}</figure>}
      <div class="hero-strip"><span>{concept==='blueprint' ? 'STACK /' : 'В РАБОТЕ —'}</span><span>Unity · C# · ECS / DOTS</span><span>Архитектура · UI · Интеграции</span><span>Go · PostgreSQL</span></div>
    </section>
    <section class="c-projects c-wrap" id="games"><div class="c-section-head"><div><span class="c-eyebrow">01 / ИГРЫ</span><h2>{concept==='atelier' ? 'Сделано вместе.' : concept==='blueprint' ? 'Проекты и мой вклад' : 'Игры, за которыми — работа.'}</h2></div><p>Четыре проекта. Разные задачи.<br/>Конкретный вклад в результат команды.</p></div><div class="c-game-grid">{games.map((game,index)=><article class="c-game" id={`game-${game.id}`}><a class="c-game-media" href={game.links[0].url} target="_blank" rel="noopener noreferrer" aria-label={`${game.title} — открыть ${game.links[0].label}`}>
      {gameImages[game.id] ? <img src={`${base}/images/${gameImages[game.id]}`} alt={`Официальное изображение ${game.title}`} loading="lazy" width="526" height="296"/> : <div class="thesia-placeholder"><span>THESIA</span><small>ISEKAI WORLD RPG / ВИДЕОАРХИВ</small></div>}<span class="media-arrow">↗</span></a><div class="game-title-row"><span class="project-index">0{index+1}</span><div><h3>{game.title}</h3><p>{game.summary.ru}</p></div></div>{game.contributions.length>0 && <details><summary>Мой вклад <span>+</span></summary><ul>{game.contributions.map(c=><li>{c.ru}</li>)}</ul></details>}<div class="c-project-links">{game.links.map(link=><a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}</div></article>)}</div></section>
    <section class="c-engineering" id="backend"><div class="c-wrap c-backend-grid"><div><span class="c-eyebrow">02 / БЭКЕНД</span><h2>{concept==='atelier' ? <>За хорошим опытом —<br/><em>хорошая система.</em></> : <>От игровых систем<br/>к серверной логике.</>}</h2><p class="backend-description">Коммерческий опыт в C#/Unity применяю в собственном Go-проекте: проектирую границы модулей, API и работу с данными.</p><div class="homealone-label"><span class="c-dot"></span> HomeAlone <small>ЛИЧНЫЙ ПРОЕКТ · В РАЗРАБОТКЕ</small></div><p>{backend.summary.ru}</p><div class="c-tags">{['Go','PostgreSQL','pgx','REST API','Docker'].map(tag=><span>{tag}</span>)}</div></div><div class="backend-sheet"><div class="sheet-title"><span>HOMEALONE</span><span>АРХИТЕКТУРА</span></div><div class="layer"><span>01</span><strong>HTTP transport</strong><small>Запросы и ответы</small></div><div class="layer"><span>02</span><strong>Service</strong><small>Логика приложения</small></div><div class="layer"><span>03</span><strong>Repository</strong><small>Интерфейсы хранилища</small></div><div class="layer database-layer"><span>↳</span><strong>PostgreSQL / pgx</strong><small>SQL · миграции</small></div><details><summary>Текущая реализация <span>+</span></summary><ul>{backend.contributions.map(c=><li>{c.ru}</li>)}</ul></details><details><summary>В планах: Kafka, Redis и gRPC <span>+</span></summary><ul>{backend.roadmap.map(c=><li>{c.ru}</li>)}</ul></details></div></div></section>
    <section class="c-articles c-wrap" id="articles"><div class="c-section-head"><div><span class="c-eyebrow">03 / СТАТЬИ</span><h2>{concept==='atelier' ? 'Из мастерской.' : 'Разбираюсь и делюсь.'}</h2></div><p>Технический опыт.<br/>Без магии под капотом.</p></div><a class="c-article" href={article.url} target="_blank" rel="noopener noreferrer"><span class="article-number">01</span><div><span class="c-eyebrow">ХАБР / UNITY · ГРАФИКА · MOBILE</span><h3>{article.title.ru}</h3><p>Собственный воксельный мир, подходы к рендерингу и ограничения мобильного GPU.</p></div><span class="article-link">Читать ↗</span></a></section>
    <section class="c-about c-wrap"><span class="c-eyebrow">О ПОДХОДЕ</span><p>Люблю, когда сложная система становится понятной. Проектирую модули, развиваю core-компоненты и помогаю команде быстрее работать с игровыми механиками и интерфейсами.</p></section>
    <section class="c-contact-section c-wrap" id="contact"><span class="c-eyebrow">ОБСУДИМ ВАШ ПРОЕКТ?</span><h2>{concept==='atelier' ? <>Создадим что-нибудь<br/><em>интересное.</em></> : <>Хорошие проекты<br/>начинаются с разговора.</>}</h2><div><a href="https://github.com/o1o1o1o1o2" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="https://habr.com/ru/users/o1o1o1o1o2/" target="_blank" rel="noopener noreferrer">Хабр ↗</a><span>Unity / C# · Go · Удалённо</span></div></section>
  </main><footer class="c-footer c-wrap"><span>Данил / 2026</span><span>Концепт {v.number} — {v.name} · {v.accent}</span><a href="#content">Наверх ↑</a></footer>
</body></html>
