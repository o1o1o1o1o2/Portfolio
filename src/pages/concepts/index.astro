---
import '../../styles/concepts.css';
const base = import.meta.env.BASE_URL.replace(/\/$/,'');
const variants = [
 {slug:'editorial',number:'01',name:'Editorial',label:'Светлый редакционный',description:'Проекты на первом плане. Много воздуха, чёрная типографика, кобальтовый акцент и большие игровые превью.',heading:'Разрабатываю игры. Думаю системами.',palette:['#f8f9f7','#171c23','#2155df']},
 {slug:'blueprint',number:'02',name:'Blueprint',label:'Тёмный инженерный',description:'Глубокий синий фон, точная сетка и схемы. Технический вклад и архитектура видны уже на первом экране.',heading:'Игровой опыт. Инженерный подход.',palette:['#0c1625','#ecf3fc','#90beff']},
 {slug:'atelier',number:'03',name:'Atelier',label:'Тёплый авторский',description:'Цвет бумаги, терракота, крупная антиква и асимметричная композиция. Спокойная подача с характером.',heading:'Серьёзно к коду. С интересом к игре.',palette:['#f1ede3','#2d302a','#a44732']},
];
---
<!doctype html><html lang="ru"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Три направления — портфолио Данила</title></head><body class="editorial"><main class="concept-gallery"><span class="c-eyebrow">ПОРТФОЛИО ДАНИЛА / ВЫБОР НАПРАВЛЕНИЯ</span><h1>Три подхода.<br/><em>Один разработчик.</em></h1><p class="gallery-intro">Рабочие HTML-концепты с реальными играми, HomeAlone и статьёй.<br/>Сравниваем характер, композицию и подачу. Текущая главная страница не заменена.</p><a href={`${base}/concepts/motion/`} style="display:block;margin-top:30px;padding:22px;background:#202127;color:#fff;border-radius:8px;font-size:16px">Новое направление: Motion — компактное вступление и динамичная галерея проектов ↗</a><div class="gallery-grid">{variants.map(v=><a class="concept-option" href={`${base}/concepts/${v.slug}/`}><div class:list={['mini-preview',v.slug]}><div class="mini-nav"><b>d.</b><span>Игры &nbsp; Бэкенд &nbsp; Статьи</span></div><div class="mini-content"><div><small>SENIOR UNITY DEVELOPER</small><strong>{v.heading}</strong><i>Смотреть проекты ↗</i></div>{v.slug==='blueprint'?<div class="mini-system">HTTP API<br/>↓<br/>CORE SYSTEMS<br/>↓<br/>PostgreSQL</div>:<img src={`${base}/images/samedi.webp`} alt="Samedi Manor в концепте страницы"/>}</div><div class="mini-rule"></div></div><div class="option-heading"><span>{v.number} / {v.name}</span><span>↗</span></div><h2>{v.label}</h2><p>{v.description}</p><div class="palette">{v.palette.map(c=><span style={`background:${c}`} />)}<span class="open-concept">Открыть концепт →</span></div></a>)}</div><p class="gallery-note">Во всех вариантах: обычное профессиональное портфолио, имя без фамилии. Для выбора подготовлена русская версия; английская будет адаптирована после выбора направления.</p></main></body></html>
<style>.concept-gallery{max-width:1400px;margin:auto;padding:65px 45px}.concept-gallery h1{font-size:clamp(42px,5vw,72px);letter-spacing:-3px;line-height:1.08;font-weight:500;margin:25px 0}.concept-gallery h1 em{color:#2155df;font-style:normal}.gallery-intro{font-size:14px;line-height:1.9;color:#626a73}.gallery-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:30px;margin-top:45px}.mini-preview{padding:18px;background:var(--bg);color:var(--ink);border:1px solid #d9dde0;aspect-ratio:1.35;overflow:hidden}.mini-nav{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);padding-bottom:10px}.mini-nav b{color:var(--accent);font-size:22px;letter-spacing:-2px}.mini-nav span{font-size:6px}.mini-content{display:grid;grid-template-columns:1.1fr 1fr;gap:12px;margin-top:28px}.mini-content small{display:block;font-size:5px;color:var(--accent);letter-spacing:.4px}.mini-content strong{display:block;font-size:clamp(16px,1.8vw,26px);letter-spacing:-.8px;line-height:1.1;margin-top:10px;font-weight:500}.mini-content i{display:inline-block;margin-top:15px;padding:7px 8px;background:var(--accent);color:var(--contrast);font-size:5px;font-style:normal}.mini-content img{width:100%;height:120px;object-fit:cover;margin-top:3px}.mini-rule{border-bottom:1px solid var(--line);margin-top:28px}.atelier .mini-content strong{font-family:Georgia,serif;font-style:italic;font-size:clamp(18px,2vw,29px)}.atelier .mini-content img{transform:rotate(3deg);border:5px solid #faf7ef}.mini-system{text-align:center;padding:20px 5px;background:var(--surface);border:1px solid var(--line);font:8px 'IBM Plex Mono',monospace;color:var(--accent);line-height:2.1}.option-heading{display:flex;justify-content:space-between;font:11px 'IBM Plex Mono',monospace;color:#626a73;margin-top:22px}.concept-option h2{font-size:24px;margin:13px 0;letter-spacing:-.7px}.concept-option>p{font-size:13px;line-height:1.8;color:#626a73;margin:0;min-height:75px}.palette{display:flex;gap:7px;margin-top:20px;align-items:center}.palette>span:not(.open-concept){width:17px;height:17px;border:1px solid #b8bbc0;border-radius:50%}.open-concept{margin-left:auto;font-size:11px;color:#2155df}.gallery-note{margin-top:50px;border-top:1px solid #d9dde0;padding-top:23px;max-width:850px;font-size:12px;line-height:1.9;color:#626a73}.concept-option:hover .open-concept{text-decoration:underline}@media(max-width:950px){.gallery-grid{grid-template-columns:1fr;max-width:650px}.concept-gallery{padding:35px 22px}.mini-preview{aspect-ratio:1.8}.mini-content strong{font-size:32px!important}.mini-content img{height:160px}.mini-content{margin-top:25px;gap:25px}.mini-content small{font-size:8px}.mini-content i{font-size:8px}.mini-nav span{font-size:8px}.mini-system{font-size:12px}.concept-option>p{min-height:0}.mini-rule{margin-top:18px}}@media(max-width:420px){.mini-preview{aspect-ratio:1.25;padding:13px}.mini-content{gap:10px}.mini-content strong{font-size:22px!important}.mini-content img{height:130px}.mini-content small{font-size:5px}.mini-content i{font-size:5px}.mini-system{font-size:8px}.concept-gallery h1{letter-spacing:-2px}}</style>
